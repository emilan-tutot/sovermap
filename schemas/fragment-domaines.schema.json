                      "enum": [
                        "ok",
                        "nxdomain",
                        "nodata",
                        "echec"
                      ]
                    },
                    "as": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "maxItems": 100
                    },
                    "exploitants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "role": {
                            "enum": [
                              "hébergé par",
                              "diffusé par"
                            ]
                          },
                          "societe": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "maxLength": 100
                          },
                          "preuve": {
                            "type": "string",
                            "maxLength": 200
                          },
                          "niveau": {
                            "enum": [
                              "confirmé",
                              "probable",
                              "non déterminé"
                            ]
                          }
                        },
                        "required": [
                          "role",
                          "societe",
                          "preuve",
                          "niveau"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 100
                    },
                    "categorie": {
                      "enum": [
                        "France",
                        "UE hors France",
                        "Europe hors UE",
                        "hors d'Europe",
                        "non déterminé"
                      ]
                    },
                    "horsUE": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "niveau": {
                      "enum": [
                        "confirmé",
                        "probable",
                        "non déterminé"
                      ]
                    }
                  },
                  "required": [
                    "hote",
                    "etat",
                    "as",
                    "exploitants",
                    "categorie",
                    "horsUE",
                    "niveau"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 50
              },
              "categorie": {
                "enum": [
                  "France",
                  "UE hors France",
                  "Europe hors UE",
                  "hors d'Europe",
                  "non déterminé"
                ]
              },
              "horsUE": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "niveau": {
                "enum": [
                  "confirmé",
                  "probable",
                  "non déterminé"
                ]
              },
              "spf": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "statut": {
                    "enum": [
                      "absent",
                      "lu",
                      "limite dépassée",
                      "boucle",
                      "echec"
                    ]
                  },
                  "inclus": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 253,
                      "pattern": "^[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?(\\.[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?)*$"
                    },
                    "maxItems": 50
                  },
                  "reseaux": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "as": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "as"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 50
                  },
                  "reseauxTotal": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "nonEvalues": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "statut",
                  "inclus",
                  "reseaux",
                  "reseauxTotal",
                  "nonEvalues"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "etat",
              "mx",
              "hotes",
              "categorie",
              "horsUE",
              "niveau",

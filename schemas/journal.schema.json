{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "journal.schema.json",
  "title": "Sovermap : les changements confirmés d'un jour",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "etatInitial": {
      "type": "boolean"
    },
    "reglesChangees": {
      "type": "boolean"
    },
    "changements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domaine": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?(\\.[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?)*$"
          },
          "couche": {
            "enum": [
              "adresses",
              "serveursDeNoms",
              "messagerie"
            ]
          },
          "avant": {
            "type": "string",
            "maxLength": 2000
          },
          "apres": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "domaine",
          "couche",
          "avant",
          "apres"
        ],
        "additionalProperties": false
      },
      "maxItems": 100000
    }
  },
  "required": [
    "date",
    "etatInitial",
    "reglesChangees",
    "changements"
  ],
  "additionalProperties": false
}

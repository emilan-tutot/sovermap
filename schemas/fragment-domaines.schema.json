        "required": [
          "domaine",
          "nomWeb",
          "perimetre",
          "raisons",
          "plateforme",
          "organismes",
          "ministeres",
          "noms",
          "zone",
          "serveursDeNoms",
          "messagerie"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    },
    "parties": {
      "type": "integer",
      "minimum": 2
    }
  },
  "required": [
    "domaines"
  ],
  "additionalProperties": false
}

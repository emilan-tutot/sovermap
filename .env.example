# Exemple de variables d'environnement, sans aucune valeur réelle.
# Aucun secret n'est nécessaire à Sovermap.

# La porte de la production (lib/porte.ts) : « open » seulement à l'ouverture, sur décision du propriétaire.
# Toute autre valeur (ou l'absence) garde la porte fermée : la page d'attente seule, la page 404 partout ailleurs,
# aucune lecture de données. Elle se lit au build : une nouvelle valeur demande un nouveau déploiement.
SITE_PUBLIC=closed

# Indexation par les moteurs de recherche : « open » seulement à l'ouverture, sur décision du propriétaire, et
# seulement derrière une porte ouverte. Toute autre valeur (ou l'absence) ferme le site aux moteurs : robots.txt qui
# interdit tout, noindex, sitemap vide.
SITE_INDEXING=closed

# Propriétaire du dépôt GitHub qui publie les données (nom de compte). Lu par le serveur seulement, pour l'adresse
# de lecture des données (B.9), sans jamais écrire ce nom dans un fichier. L'agent utilisateur ne le contient jamais.
SOVERMAP_GITHUB_OWNER=

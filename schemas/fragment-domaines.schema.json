                "maxLength": 253,
                "pattern": "^[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?(\\.[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?)*$"
              },
              "ds": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "caa": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "object",
                  "properties": {
                    "propriete": {
                      "enum": [
                        "issue",
                        "issuewild"
                      ]
                    },
                    "valeur": {
                      "type": "string",
                      "maxLength": 255
                    }
                  },
                  "required": [
                    "propriete",
                    "valeur"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 50
              }
            },
            "required": [
              "etat",
              "echec",
              "ns",
              "soa",
              "ds",
              "caa"
            ],
            "additionalProperties": false

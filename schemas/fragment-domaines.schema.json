                          "preuve": {
                            "type": "string",
                            "maxLength": 200
                          },
                          "niveau": {
                            "enum": [
                              "confirmé",
                              "probable",
                              "non déterminé"
                            ]
                          }
                        },
                        "required": [
                          "role",
                          "societe",
                          "preuve",
                          "niveau"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 100
                    },
                    "categorie": {
                      "enum": [
                        "France",
                        "UE hors France",
                        "Europe hors UE",
                        "hors d'Europe",
                        "non déterminé"
                      ]
                    },
                    "horsUE": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "niveau": {
                      "enum": [
                        "confirmé",
                        "probable",
                        "non déterminé"
                      ]
                    }
                  },
                  "required": [
                    "hote",
                    "etat",
                    "as",
                    "exploitants",
                    "categorie",
                    "horsUE",
                    "niveau"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 50
              },
              "categorie": {
                "enum": [
                  "France",
                  "UE hors France",
                  "Europe hors UE",
                  "hors d'Europe",
                  "non déterminé"
                ]
              },
              "horsUE": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "niveau": {
                "enum": [
                  "confirmé",
                  "probable",
                  "non déterminé"
                ]
              }
            },
            "required": [
              "hotes",
              "categorie",
              "horsUE",
              "niveau"
            ],
            "additionalProperties": false
          },

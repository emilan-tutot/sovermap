                    }
                  },
                  "required": [
                    "preference",
                    "hote"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 50
              },
              "hotes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "hote": {
                      "type": "string",
                      "maxLength": 253,
                      "pattern": "^[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?(\\.[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?)*$"

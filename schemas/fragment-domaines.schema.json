{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fragment-domaines.schema.json",
  "title": "Sovermap : un fragment de domaines enregistrés",
  "type": "object",
  "properties": {
    "domaines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domaine": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?(\\.[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?)*$"
          },
          "nomWeb": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?(\\.[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?)*$"
          },
          "perimetre": {
            "enum": [
              "État",
              "hors État"
            ]
          },
          "raisons": {
            "type": "array",
            "items": {
              "enum": [
                "gouv.fr",
                "dila",
                "sig",
                "mesr"
              ]
            },
            "maxItems": 5
          },
          "plateforme": {
            "type": "boolean"
          },
          "organismes": {
            "type": "integer",
            "minimum": 0
          },
          "ministeres": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "maxItems": 50
          },
          "noms": {
            "type": "integer",
            "minimum": 1
          },
          "zone": {
            "type": "object",
            "properties": {
              "etat": {
                "enum": [
                  "ok",
                  "nxdomain",
                  "nodata",
                  "echec"
                ]
              },
              "echec": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "confirmePar": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 20
                  }
                },
                "required": [
                  "code",
                  "confirmePar"
                ],
                "additionalProperties": false
              },
              "ns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?(\\.[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?)*$"
                },
                "maxItems": 50
              },
              "soa": {
                "type": [
                  "string",
                  "null"

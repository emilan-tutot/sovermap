# Exemple de variables d'environnement, sans aucune valeur réelle.
# Aucun secret n'est nécessaire à Sovermap.

# Indexation par les moteurs de recherche : « open » seulement à l'ouverture, sur décision du propriétaire.
# Toute autre valeur (ou l'absence) ferme le site : robots.txt qui interdit tout, noindex, sitemap vide.
SITE_INDEXING=closed

# Propriétaire du dépôt GitHub qui publie les données (nom de compte). Lu par le serveur et par la collecte,
# pour ne jamais écrire ce nom en dur dans le code.
SOVERMAP_GITHUB_OWNER=
